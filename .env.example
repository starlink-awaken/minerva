# Minerva Configuration — copy to .env and fill in your keys
# cp .env.example .env

# Required: Ollama (local LLM)
# Install: brew install ollama && ollama serve
# No key needed — runs locally

# Optional: Cloud LLM APIs (for L3/L4 enterprise reasoning)
DEEPSEEK_API_KEY=sk-your-deepseek-key
GLM_API_KEY=your-glm-key
LONGCAT_API_KEY=ak-your-longcat-key

# Optional: Search APIs
EXA_API_KEY=your-exa-key
METASO_API_KEY=mk-your-metaso-key
ZHIPU_API_KEY=your-zhipu-key
JINA_API_KEY=your-jina-key

# Optional: Graph Database
NEO4J_PASSWORD=minerva123

# Optional: Web Security
MINERVA_API_KEY=your-api-key-for-web-auth
