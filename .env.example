# Minerva Configuration
# cp .env.example .env
# docker compose --profile full up -d

# ── LLM APIs (cloud reasoning, L3+) ──
DEEPSEEK_API_KEY=sk-your-deepseek-key
GLM_API_KEY=your-glm-key
LONGCAT_API_KEY=ak-your-longcat-key

# ── Search APIs ──
EXA_API_KEY=your-exa-key
METASO_API_KEY=mk-your-metaso-key
ZHIPU_API_KEY=your-zhipu-key

# ── Neo4j Knowledge Graph ──
NEO4J_PASSWORD=generate-a-random-password-here

# ── Web Security ──
MINERVA_API_KEY=your-api-key-for-web-auth

# ── Docker ──
MINERVA_LOG_LEVEL=info
